<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Default base URL for API. Override at runtime via UserDefaults key `API_BASE_URL`. -->
    <key>API_BASE_URL</key>
    <string>https://app.claritas.info</string>
    <!-- OAuth callback URL consumed by ASWebAuthenticationSession and backend redirect handling. -->
    <key>AUTH_CALLBACK_URL</key>
    <string>claritas://auth/callback</string>
</dict>
</plist>
