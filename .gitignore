**/.terraform/
**/*.tfstate
**/*.tfstate.*

# macOS
.DS_Store

# Xcode user state
**/xcuserdata/
**/*.xcuserstate

# Apple signing and push credentials are deployment secrets, never source.
AuthKey_*.p8
aps*.cer
*.p12
*.mobileprovision

# Local credentials must never enter a release commit.
**/.env
**/.env.*
!**/.env.example
!**/.env.template
*.pem
*.key
*.pfx
*.jks
**/application_default_credentials.json
**/service-account*.json

# JavaScript dependencies and build caches
**/node_modules/
**/dist/
# Download Cloud SQL Auth Proxy binaries locally when needed; never commit them.
/cloud-sql-proxy
