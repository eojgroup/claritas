flowchart TB
  subgraph Clients
    WEB[React web application]
    IOS[SwiftUI iPhone and iPad application]
    WATCH[watchOS application]
  end

  subgraph Edge_and_identity[Edge and identity]
    LB[GKE Ingress and managed TLS]
    KC[Keycloak]
  end

  subgraph Cost_optimized_GKE[Cost-optimized GKE runtime]
    API[Express API - one replica]
    INGEST[In-process elected ingestion workers]
    OPENCODE[OpenCode briefing service]
    WEBPOD[Nginx web - one replica]
    PROXY[Cloud SQL Auth Proxy sidecars]
  end

  subgraph Connectors
    NEWS[GDELT and reviewed official RSS]
    WEATHER[OpenWeather and NOAA/NWS]
    MARKET[ECB, OECD, SEC EDGAR, World Bank and FRED]
    TRANSPORT[AISstream and adsb.lol]
    OTHER[Podcast Index and Wikidata]
  end

  subgraph PostgreSQL[Cloud SQL PostgreSQL - one vCPU baseline]
    CORE[source, country, item and ingestion audit]
    WX[weather snapshots, forecasts, air quality and alerts]
    MK[market instruments, indicators and events]
    TX[transport current state and bounded history]
    AUTH[application identity and briefing preferences]
  end

  WEB --> LB
  IOS --> LB
  WATCH --> LB
  LB --> WEBPOD
  LB --> API
  WEB --> KC
  IOS --> KC
  API --> PROXY
  KC --> PROXY
  PROXY --> CORE
  PROXY --> WX
  PROXY --> MK
  PROXY --> TX
  PROXY --> AUTH
  API --> INGEST
  INGEST --> NEWS
  INGEST --> WEATHER
  INGEST --> MARKET
  INGEST --> TRANSPORT
  INGEST --> OTHER
  API --> OPENCODE
