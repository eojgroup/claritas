flowchart TB
  USER[Web, iOS, iPadOS and watchOS users]
  OPS[Claritas operators]
  IDP[Keycloak and federated identity providers]
  APP[Claritas web and native applications]
  API[Claritas API and ingestion workers on GKE]
  DB[(Cloud SQL for PostgreSQL)]
  DATA[Reviewed public data providers]
  LLM[Provider-neutral briefing model]
  MAIL[SMTP delivery provider]
  OBS[Google Cloud logging and monitoring]

  USER --> APP
  APP -->|OIDC| IDP
  APP -->|HTTPS| API
  API --> DB
  API -->|bounded polling| DATA
  API --> LLM
  API --> MAIL
  API --> OBS
  OPS --> OBS
